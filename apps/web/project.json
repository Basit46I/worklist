{
  "name": "web",
  "type": "app",
  "description": "Primary Next.js web application.",
  "internalDependencies": ["eslint-config", "tsconfig", "ui", "worklist-ui"],
  "externalDependencies": ["@playwright/test", "@tanstack/react-virtual", "lucide-react", "next", "react", "react-dom", "tailwindcss", "zod"],
  "capabilities": ["web", "app-router", "shadcn-ui", "tailwind"],
  "tasks": {
    "dev": { "command": "pnpm run dev", "cache": false },
        "dev:share": { "command": "pnpm run dev:share", "environment": ["NGROK_AUTHTOKEN"], "cache": false },
    "build": { "command": "pnpm run build", "outputs": [".next"], "environment": ["NEXT_PUBLIC_API_BASE_URL"], "cache": true },
    "test": { "command": "pnpm test", "cache": false },
    "test:e2e": { "command": "pnpm run test:e2e", "environment": ["WORKLIST_E2E_BASE_URL", "WORKLIST_E2E_EMAIL", "WORKLIST_E2E_PASSWORD"], "cache": false },
    "lint": { "command": "pnpm run lint", "cache": false },
    "typecheck": { "command": "pnpm run typecheck", "cache": false }
  }
}
