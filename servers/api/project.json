{
    "name": "api",
    "type": "server",
    "description": "Primary Express API runtime.",
    "internalDependencies": ["eslint-config", "logging", "tsconfig", "types"],
    "externalDependencies": ["@opentelemetry/api", "@opentelemetry/exporter-metrics-otlp-http", "@opentelemetry/exporter-trace-otlp-http", "@opentelemetry/sdk-metrics", "@opentelemetry/sdk-node", "@prometheus-io/client", "dotenv", "express", "express-rate-limit", "mongoose", "nodemailer", "rate-limit-redis", "redis", "zod"],
    "capabilities": ["http-api", "health", "readiness-check", "mongodb-integration", "auth-rate-limiting", "prometheus-metrics", "open-telemetry-tracing", "operations-alerts"],
    "tasks": {
        "dev": {
            "command": "pnpm run dev",
            "environment": [
                "API_HOST",
                "API_PORT",
                "API_RATE_LIMIT_MAX",
                "API_RATE_LIMIT_WINDOW_MS",
                "API_TRUST_PROXY_HOPS",
                "WEB_ORIGIN",
                "MONGODB_URI",
                "REDIS_URL",
                "SMTP_HOST",
                "SMTP_PORT",
                "SMTP_USER",
                "SMTP_PASSWORD",
                "EMAIL_FROM",
                "METRICS_BEARER_TOKEN",
                "ALERT_WEBHOOK_URL",
                "OTEL_EXPORTER_OTLP_ENDPOINT",
                "OTEL_EXPORTER_OTLP_HEADERS"
            ],
            "cache": false
        },
        "load:smoke": { "command": "pnpm run load:smoke", "cache": false },
        "load:stress": { "command": "pnpm run load:stress", "cache": false },
        "build": { "command": "pnpm run build", "outputs": ["dist"], "cache": true },
        "test": { "command": "pnpm test", "cache": false },
        "lint": { "command": "pnpm run lint", "cache": false },
        "typecheck": { "command": "pnpm run typecheck", "cache": false }
    }
}
