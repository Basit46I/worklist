{
    "name": "api",
    "type": "server",
    "description": "Primary Express API runtime.",
    "internalDependencies": ["eslint-config", "logging", "tsconfig", "types"],
    "externalDependencies": ["dotenv", "express", "express-rate-limit", "mongoose", "nodemailer", "zod"],
    "capabilities": ["http-api", "health", "readiness-check", "mongodb-integration", "auth-rate-limiting"],
    "tasks": {
        "dev": {
            "command": "pnpm run dev",
            "environment": [
                "API_HOST",
                "API_PORT",
                "WEB_ORIGIN",
                "MONGODB_URI",
                "SMTP_HOST",
                "SMTP_PORT",
                "SMTP_USER",
                "SMTP_PASSWORD",
                "EMAIL_FROM"
            ],
            "cache": false
        },
        "build": { "command": "pnpm run build", "outputs": ["dist"], "cache": true },
        "test": { "command": "pnpm test", "cache": false },
        "lint": { "command": "pnpm run lint", "cache": false },
        "typecheck": { "command": "pnpm run typecheck", "cache": false }
    }
}
