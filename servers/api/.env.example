NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
API_RATE_LIMIT_MAX=1000
API_RATE_LIMIT_WINDOW_MS=60000
API_TRUST_PROXY_HOPS=0
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=debug
# Optional: enables the private Prometheus scrape endpoint. Use a random value of at least 32 characters.
# METRICS_BEARER_TOKEN=replace-with-a-long-random-secret
# Optional: post active operations alerts to an HTTPS-compatible incoming webhook.
# ALERT_WEBHOOK_URL=https://hooks.example.com/worklist-alerts
# Optional: send traces and aggregated API metrics to any OTLP/HTTP-compatible backend.
# OTEL_EXPORTER_OTLP_ENDPOINT=https://your-collector.example.com
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer%20replace-with-secret
# MONGODB_URI=mongodb://127.0.0.1:27017/workspace
# Configure REDIS_URL when running multiple API instances so rate limits are shared.
# REDIS_URL=redis://127.0.0.1:6379
# Configure all SMTP values together to enable invitations and account email flows.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-username
# SMTP_PASSWORD=your-smtp-password
# EMAIL_FROM=Worklist <no-reply@example.com>
# Set a random secret of at least 32 characters for scheduled reminders and configure the same value in Vercel.
# CRON_SECRET=replace-with-a-long-random-secret
