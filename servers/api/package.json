{
    "name": "@workspace/api",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "tsx watch server.ts",
        "build": "tsc -p tsconfig.build.json",
        "start": "node dist/server.js",
        "test": "tsx --test features/auth/tests/*.test.ts features/health/tests/*.test.ts features/worklist/tests/*.test.ts tests/environment.test.ts tests/http-boundaries.test.ts tests/load-check.test.mjs tests/mongodb.test.ts tests/rate-limit-redis.test.ts tests/shutdown.test.ts",
        "load:smoke": "node scripts/load-check.mjs",
        "load:stress": "node scripts/load-check.mjs --mode stress",
        "lint": "eslint \"**/*.ts\"",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@workspace/logging": "workspace:*",
        "@workspace/types": "workspace:*",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "express-rate-limit": "^8.7.1",
        "mongoose": "^9.10.1",
        "nodemailer": "^10.1.0",
        "rate-limit-redis": "^6.0.1",
        "redis": "^6.3.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@types/express": "^5.0.6",
        "@types/node": "^22.20.3",
        "@workspace/eslint-config": "workspace:*",
        "@workspace/tsconfig": "workspace:*",
        "eslint": "9.39.5",
        "tsx": "^4.23.13",
        "typescript": "5.9.3"
    },
    "engines": {
        "node": ">=20.19.0"
    }
}
