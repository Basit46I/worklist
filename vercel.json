{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "buildCommand": "cd ../.. && node codebase/cli/repo.mjs run web:build",
      "bindings": [
        {
          "type": "service",
          "service": "api",
          "format": "url",
          "env": "WORKLIST_API_INTERNAL_URL"
        }
      ]
    },
    "api": {
      "root": "servers/api",
      "framework": "express",
      "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
      "buildCommand": "cd ../.. && node codebase/cli/repo.mjs run api:build && node servers/api/scripts/clean-vercel-deploy.mjs && pnpm --filter @workspace/api deploy --prod --legacy servers/api/vercel-deploy",
      "functions": {
        "vercel-entry.mjs": {
          "includeFiles": "{vercel-deploy/**,package.json}"
        }
      },
      "entrypoint": "vercel-entry.mjs"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
